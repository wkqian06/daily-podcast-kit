# Copy to config.env and fill in. config.env is gitignored — never commit it.

# ---- Delivery target 1: public web page (optional) ----------------------------
# Leave PODCAST_SPACE empty to skip. See docs/WEB_PAGE.md
# HuggingFace write token: https://huggingface.co/settings/tokens
HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxx"
# The single Space every episode is published to. Created automatically on first run.
PODCAST_SPACE="your-username/daily-podcast"

# ---- Delivery target 2: private podcast feed (optional) -----------------------
# Subscribe in any podcast app. Leave empty to skip. See docs/PRIVATE_RSS.md
RSS_BASE=""              # https://private-podcast.<subdomain>.workers.dev
RSS_UPLOAD_TOKEN=""      # the UPLOAD_TOKEN you set as a Worker secret

# Shown on the page and the Space card.
PODCAST_TITLE="The Daily Ten"
PODCAST_AUTHOR=""
PODCAST_BLURB="Ten minutes on one thing worth understanding. A paper read closely, a story worth telling, an argument worth having. Anything is fair game."

# Optional second-language transcript. Leave empty to disable.
# Anything non-empty enables translate_segments.py; edit its prompt for other languages.
TRANSLATE_TO="zh"

# Optional voice override. See https://huggingface.co/hexgrad/Kokoro-82M
KOKORO_EN_VOICE="af_heart"
