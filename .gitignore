# Secrets — never commit
config.env

# Generated audio and site output
weekly/audio/
site/
logs/
.published

# Your own podcast. The kit is the code; what it produces is yours and stays here:
# episodes/NNN/ the proposals, scripts, metadata and audio,
# materials/NNN/ the papers you obtained by hand (publisher PDFs).
# 001-example is the exception: a real episode kept as the format reference.
episodes/*
!episodes/001-example/
materials/

# Podcast material recovered from elsewhere. A local record, not part of the kit.
archive/

# Editor / agent workspace
.claude/

# Python
__pycache__/
*.pyc
.venv/
venv/
